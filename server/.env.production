# Production Environment Variables for Render Deployment
# Copy these to Render's Environment Variables section

# Server Configuration
NODE_ENV=production
PORT=5000

# Frontend URL (Update with your actual Render frontend URL)
CLIENT_URL=https://your-frontend-app.onrender.com

# MongoDB Atlas (Keep your existing connection string)
MONGO_URI=YOUR_MONGO_URI

# Session Secret (Generate a new one for production)
SESSION_SECRET=YOUR_SESSION_SECRET

# Google OAuth (Update callback URLs in Google Console)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# GitHub OAuth (Update callback URLs in GitHub App settings)
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# Email Configuration
SMTP_EMAIL=your-email@example.com
SMTP_APP_PASSWORD=YOUR_SMTP_APP_PASSWORD

# Groq API Keys (Keep your existing keys)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_API_KEY_VISUALS=YOUR_GROQ_API_KEY_VISUALS
GROQ_API_KEY_REMIX=YOUR_GROQ_API_KEY_REMIX
GROQ_API_KEY_TEXT_AUDIT=YOUR_GROQ_API_KEY_TEXT_AUDIT
GROQ_API_KEY_TEXT_ENHANCE=YOUR_GROQ_API_KEY_TEXT_ENHANCE
GROQ_API_KEY_TEXT_SIMULATE=YOUR_GROQ_API_KEY_TEXT_SIMULATE